# --- Base de données Neon (Postgres managé, externe) ---
# Copie la connection string depuis le dashboard Neon (avec ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/DBNAME?sslmode=require

# --- App ---
NODE_ENV=production
PORT=4000
BACKEND_URL=https://api.shaolin-senegal.com

# --- CORS ---
FRONTEND_URL=https://shaolin-senegal.com
FRONTEND_URLS=https://shaolin-senegal.com,https://www.shaolin-senegal.com

# --- JWT ---
JWT_SECRET=remplace-par-une-longue-chaine-aleatoire
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=remplace-par-une-autre-longue-chaine-aleatoire
JWT_REFRESH_EXPIRY=7d
QR_SECRET=remplace-par-une-chaine-aleatoire

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP (emails) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Paiements en ligne (Option C, à activer plus tard) ---
# WAVE_WEBHOOK_SECRET : « signing secret » du webhook Wave (méthode signature,
# en-tête Wave-Signature t=…,v1=…). Sans lui, tous les webhooks Wave sont refusés.
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_KEY=
OM_AUTH_TOKEN=
