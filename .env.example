# ─── Base de données ─────────────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://shaolin:votre_mot_de_passe@localhost:3306/shaolin_db"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 64
JWT_SECRET="remplacer_par_un_secret_très_long_et_aléatoire_min_32_chars"
JWT_REFRESH_SECRET="remplacer_par_un_autre_secret_différent_du_précédent"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── QR Code ─────────────────────────────────────────────────────────────────
QR_SECRET="remplacer_par_un_secret_qr_code"

# ─── Cloudinary (stockage fichiers) ──────────────────────────────────────────
# Créer un compte sur https://cloudinary.com (gratuit)
CLOUDINARY_CLOUD_NAME="votre_cloud_name"
CLOUDINARY_API_KEY="votre_api_key"
CLOUDINARY_API_SECRET="votre_api_secret"

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# URL du frontend (pour le CORS)
FRONTEND_URL="http://localhost:3000"

# ─── Email (optionnel — notifications V2) ────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="votre@email.com"
SMTP_PASS="votre_mot_de_passe_application_gmail"
